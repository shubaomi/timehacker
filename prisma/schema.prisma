generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GameMode {
  HACKER
  PURE
}

enum GameStatus {
  STARTED
  COMPLETED
  ABANDONED
}

enum CheatCategory {
  OPERATION
  VISUAL
  RHYTHM
  DEVICE
  META
}

enum ReleaseTrack {
  FULL
  SOFT_LAUNCH
}

enum PlaytestEventName {
  LEVEL_VIEW         @map("level_view")
  FIRST_INTERACTION  @map("first_interaction")
  PUZZLE_DISCOVERED  @map("puzzle_discovered")
  HINT_1_OPEN        @map("hint_1_open")
  HINT_2_OPEN        @map("hint_2_open")
  ANSWER_OPEN        @map("answer_open")
  PUZZLE_ARMED       @map("puzzle_armed")
  TIMER_STARTED      @map("timer_started")
  TIMER_STOPPED      @map("timer_stopped")
  LEVEL_COMPLETED    @map("level_completed")
  NEXT_LEVEL         @map("next_level")
  SHARE_CARD_OPEN    @map("share_card_open")
  SHARE_CARD_EXPORTED @map("share_card_exported")
}

enum PlaytestEntrySource {
  DIRECT  @map("direct")
  SHARE   @map("share")
  UNKNOWN @map("unknown")
}

enum PlaytestMode {
  NORMAL   @map("normal")
  ASSISTED @map("assisted")
}

enum PlaytestShareAction {
  SAVE @map("save")
  COPY @map("copy")
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  playerId       String       @unique @db.VarChar(64)
  nickname       String?      @db.VarChar(24)
  currentLevel   Int          @default(1)
  totalGames     Int          @default(0)
  successGames   Int          @default(0)
  bestErrorMs    Int?
  firstSuccessAt DateTime?    @db.Timestamptz(3)
  releaseTrack   ReleaseTrack @default(FULL)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  games          GameRecord[]
  unlockedCheats UserCheat[]

  @@index([currentLevel, successGames, firstSuccessAt])
}

model PlaytestEvent {
  id            String                  @id @default(uuid()) @db.Uuid
  clientEventId String                  @unique @db.Uuid
  browserId     String                  @db.Uuid
  sessionId     String                  @db.Uuid
  name          PlaytestEventName
  levelSlug     String                  @db.VarChar(64)
  levelNumber   Int
  entrySource   PlaytestEntrySource
  mode          PlaytestMode?
  durationMs    Int?
  success       Boolean?
  puzzleSolved  Boolean?
  action        PlaytestShareAction?
  occurredAt    DateTime                @db.Timestamptz(3)
  receivedAt    DateTime                @default(now()) @db.Timestamptz(3)

  @@index([browserId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([name, occurredAt])
  @@index([levelNumber, name])
  @@index([occurredAt])
}

model CheatMethod {
  id             String          @id @default(uuid()) @db.Uuid
  slug           String          @unique @db.VarChar(64)
  name           String          @db.VarChar(80)
  nameZh         String?         @db.VarChar(80)
  description    String          @db.VarChar(280)
  descriptionZh  String?         @db.VarChar(280)
  hint           String          @db.VarChar(180)
  hintZh         String?         @db.VarChar(180)
  difficulty     Int
  category       CheatCategory
  triggerConfig  Json
  effectConfig   Json
  enabled        Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  assignedGames  GameRecord[]    @relation("AssignedCheat")
  usedGames      GameRecord[]    @relation("UsedCheat")
  unlockedBy     UserCheat[]

  @@index([enabled, difficulty, category])
}

model UserCheat {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  cheatId     String      @db.Uuid
  completedAt DateTime    @default(now()) @db.Timestamptz(3)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cheat       CheatMethod @relation(fields: [cheatId], references: [id], onDelete: Restrict)

  @@unique([userId, cheatId])
  @@index([cheatId, completedAt])
}

model GameRecord {
  id               String        @id @default(uuid()) @db.Uuid
  clientRequestId  String        @unique @db.VarChar(64)
  userId           String        @db.Uuid
  mode             GameMode
  status           GameStatus    @default(STARTED)
  targetMs         Int           @default(10000)
  durationMs       Int?
  wallDurationMs   Int?
  errorMs          Int?
  absoluteErrorMs  Int?
  toleranceMs      Int           @default(10)
  assistanceType  String?       @db.VarChar(32)
  success          Boolean?
  assignedCheatId  String?       @db.Uuid
  usedCheatId      String?       @db.Uuid
  startedAt        DateTime      @default(now()) @db.Timestamptz(3)
  completedAt      DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCheat    CheatMethod?  @relation("AssignedCheat", fields: [assignedCheatId], references: [id], onDelete: SetNull)
  usedCheat        CheatMethod?  @relation("UsedCheat", fields: [usedCheatId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([mode, status, absoluteErrorMs, completedAt])
  @@index([assignedCheatId])
  @@index([usedCheatId])
}
